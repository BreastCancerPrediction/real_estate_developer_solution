<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="dlp_process.DlpDashboard">

        <!-- Scrollable Wrapper with fixed height and gradient background -->
        <div class="dlp-dashboard-wrapper" style="height: 100vh; overflow-y: auto; background: linear-gradient(to right, #e0f7fa, #80deea);">
            <div class="container py-4">

                <!-- Dashboard Title -->
                <div class="text-center mb-5">
                    <h1 class="fw-bold text-primary" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.2);">DLP Dashboard</h1>
                </div>


                <!-- Centered Select -->
                <div class="d-flex justify-content-center mb-4" style="width: 150px; margin-left: auto; background-color: #f1f1f1; margin-right: auto;">
                    <select class="form-select" t-on-change="onChangeFilter">
                        <option value="">All</option>
                        <option value="this_week">This Week</option>
                        <option value="last_week">Last Week</option>
                        <option value="this_month">This Month</option>
                    </select>
                </div>
                <!-- Info Cards Loop -->
                <div class="row g-4 justify-content-center">
                    <t t-foreach="['all_workorders', 'service_appointments', 'dlp_cases']" t-as="item" t-key="item">
                        <div class="col-lg-4 col-md-6">
<!--                            <div class="card border-0 shadow-lg h-100" style="transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">-->
                            <div class="card border-0 shadow-lg h-100 text-white"
                                 t-att-data-type="item"
                                 t-on-click="onTileClick"
                                 style="background: linear-gradient(to right, #fefae6, #fcf8ee); transform 0.2s; cursor: pointer;"
                                 onmouseover="this.style.transform='scale(1.05)'"
                                 onmouseout="this.style.transform='scale(1)'">
                                <div class="card-body d-flex align-items-center p-4">

                                <div t-if="item == 'all_workorders'" class="rounded-circle bg-danger text-white d-flex justify-content-center align-items-center me-4" style="width: 55px; height: 55px;">
                                        <i class="fa fa-tasks fs-4"></i>
                                    </div>
                                    <div t-if="item == 'service_appointments'" class="rounded-circle bg-warning text-white d-flex justify-content-center align-items-center me-4" style="width: 55px; height: 55px;">
                                        <i class="fa fa-book fs-4"></i>
                                    </div>
                                    <div t-if="item == 'dlp_cases'" class="rounded-circle text-white d-flex justify-content-center align-items-center me-4" style="width: 55px; height: 55px; background-color: #bf80ff;">
                                        <i class="fa fa-file-text fs-4"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 fw-semibold" t-attf-id="{{ item }}">--</h5>
                                       <b> <p class="mb-0 text-muted" t-esc="{
                      'all_workorders': 'Work Orders',
                      'service_appointments': 'Service Appointments',
                      'dlp_cases': 'DLP Cases'
                    }[item]"/></b>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Charts Row -->
                <div class="row mt-5 gx-5 gy-4">
                    <!-- Work Order Status Donut Chart -->
                    <div class="card1 p-3 col-md-4 text-center chart-card" style= "margin-bottom: 40px; margin-left: 100px;">
                        <i class="fa fa-arrow-right chart-arrow" data-chart="work_order_status"
                           style="position: absolute; top: 10px; right: 10px; cursor: pointer;"></i>

                        <h6 class="mb-3 fw-semibold" style="color:#333;">Work Order Status</h6>
                        <canvas id="workOrderStatusChart"></canvas>
                    </div>

                    <!-- DLP Summary Pie Chart -->
                    <div class="card2 p-3 col-md-4 text-center chart-card" style= "margin-bottom: 40px; margin-left: 100px;">
                        <h6 class="mb-3 fw-semibold" style="color:#333;">DLP Summary</h6>
                        <canvas id="workorderPieChart"></canvas>
                    </div>
                    <!-- Priority Bar Chart -->
                    <div class="card3 p-3 col-md-4 text-center chart-card" style= "margin-bottom: 40px; margin-left: 100px;">
                        <h6 class="mb-3">Work Order by Priority</h6>
                        <canvas id="priorityBarChart" hight="150" width="150"></canvas>
                    </div>
                </div>
                <!-- Resolution Typology Line Chart -->
                <div class="card4 p-3"  style="height: 350px; margin-bottom: 40px;">
                    <h5>Work Order by  Resolution Typology</h5>
                    <canvas id="resolutionLineChart" style="padding: 10px;"></canvas>
                </div>

<!--                <div class="card p-3 col-md-4 text-center" style= "margin-bottom: 40px;">-->
<!--                    <h6 class="mb-3 fw-semibold" style="color:#333;">Tickets Analysis</h6>-->
<!--                    <canvas id="ticketsAnalysisPieChart" width="150" height="150" style="padding: 10px;"></canvas>-->
<!--                </div>-->
<!--&lt;!&ndash;           -->

            </div>
        </div>

    </t>
</templates>

