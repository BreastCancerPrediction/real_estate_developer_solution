<odoo>
    <data>

        <!-- Service Appointment mail sends to assigned user -->
        <record id="service_appointment_email_template" model="mail.template">
            <field name="name">Service Appointment Notification</field>
            <field name="model_id" ref="appointment.model_appointment_type"/>
            <field name="subject">New Service Appointment Assigned: {{object.name}}</field>
            <field name="email_from">{{user.email or 'info@example.com'}}</field>
           <field name="email_to">{{object.staff_user_ids[0].email}}</field>
            <field name="body_html" type="html">
                <p>Hello <t t-out="object.staff_user_ids.name"/>,
                </p>
                <p>You have been assigned to a new Service Appointment:
                    <strong>
                        <t t-out="object.name"/>
                    </strong>
                    .
                </p>
                <p>Best Regards,</p>
                <p>Your Company</p>
                <p><t t-out="user.company_id.name"/></p>
            </field>
        </record>

    </data>
</odoo>
