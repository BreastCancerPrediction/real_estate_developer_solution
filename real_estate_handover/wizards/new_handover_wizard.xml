<odoo>
    <record id="view_handover_wizard" model="ir.ui.view">
        <field name="name">handover.wizard.form</field>
        <field name="model">handover.wizard</field>
        <field name="arch" type="xml">
            <form string="New Handover">
                <group>
                    <field name="handover_type" widget="radio"/>
                </group>
                <footer>
                    <button string="Next" type="object" name="next_action" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="handover_wizard_action" model="ir.actions.act_window">
        <field name="name">Handover Wizard</field>
        <field name="res_model">handover.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
