<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_handover_documents_form" model="ir.ui.view">
        <field name="name">handover.documents.form.view</field>
        <field name="model">handover.documents</field>
        <field name="arch" type="xml">
            <form string="Handover Documents">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_handover_documents_list" model="ir.ui.view">
        <field name="name">handover.documents.list.view</field>
        <field name="model">handover.documents</field>
        <field name="arch" type="xml">
            <list string="Handover Documents">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_handover_documents" model="ir.actions.act_window">
        <field name="name">Handover Documents</field>
        <field name="res_model">handover.documents</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new handover Documents record.
            </p>
        </field>
    </record>

        <menuitem
        id="menu_handover_documents"
        name="Handover Documents"
        parent="configuration"
        action="action_handover_documents"
        sequence="5"/>
</odoo>
