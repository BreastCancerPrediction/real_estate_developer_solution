<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Property rental cron action -->
       <record id="ir_cron_property_rental_action" model="ir.cron">
           <field name="name">Property Rental</field>
           <field name="model_id" ref="model_property_rental"/>
           <field name="state">code</field>
           <field name="code">model.action_check_rental()</field>
           <field name="user_id" ref="base.user_root"/>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
<!--           <field name="numbercall">-1</field>-->
       </record>

        <!-- Check Installments cron action -->
          <record id="ir_cron_check_unit_installments" model="ir.cron">
            <field name="name">Check Installments</field>
            <field name="model_id" ref="model_crm_lead_installment"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_installments()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
            <field name="active">True</field>
        </record>

        <!-- Generate Invoices for Unpaid Installments cron action -->
        <record id="crm_installment_invoice_cron" model="ir.cron">
            <field name="name">Generate Invoices for Unpaid Installments</field>
            <field name="model_id" ref="model_crm_lead_installment"/>
            <field name="state">code</field>
            <field name="code">model._generate_installment_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
