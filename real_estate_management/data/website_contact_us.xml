<odoo>
    <template id="contactus_form_inherit" inherit_id="website.contactus">

        <xpath expr="//h1" position="replace">
            <h1>Real Estate Inquiry</h1>
        </xpath>

        <xpath expr="//p[contains(@class, 'lead')]" position="replace">
            <p class="lead">
                Have questions about buying, selling, or renting a property?
                <br/>
                Get in touch with us for expert real estate assistance!
            </p>
        </xpath>

