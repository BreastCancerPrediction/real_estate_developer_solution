<!--                </label>-->
<!--                <input id="state" type="text" class="form-control s_website_form_input" name="State"/>-->
<!--            </div>-->
<!--        </xpath>-->

        <xpath expr="//div[@data-name='Submit Button']" position="attributes">
            <attribute name="id">sub_btn</attribute>
        </xpath>

        <xpath expr="//textarea[contains(@name, 'description')]" position="attributes">
            <attribute name="rows">1</attribute>
        </xpath>
        <!-- Replace Company Details Section with an Image -->
        <xpath expr="//div[contains(@class, 'col-lg-4') and contains(@class, 'offset-lg-1')]" position="replace">
            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0 text-center">
                <img src="/real_estate_management/static/src/img/Enquiry_Form.jpg" alt="Contact Image"
                     class="img-fluid rounded"/>
            </div>
        </xpath>
        <!-- Center the Submit Button -->
        <xpath expr="//div[contains(@class, 's_website_form_submit')]" position="attributes">
            <attribute name="class">mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-center
            </attribute>
        </xpath>
        <!-- Add Grey Background to Form -->
        <xpath expr="//section[contains(@class, 's_website_form')]" position="attributes">
            <attribute name="t-attf-style">background-color: #f0f0f0; padding: 20px; border-radius: 8px;</attribute>
        </xpath>

    </template>

