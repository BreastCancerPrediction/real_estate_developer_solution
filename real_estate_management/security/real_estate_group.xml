        </record>

        <!-- Manager 1 Group -->
        <record id="group_real_estate_manager_1" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="category_real_estate_manager"/>
        </record>

        <!-- Senior Manager Group -->
        <record id="group_real_estate_manager_2" model="res.groups">
