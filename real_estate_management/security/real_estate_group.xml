        <!-- Real Estate Category -->
        <record id="category_real_estate" model="ir.module.category">
            <field name="name">Real Estate</field>
            <field name="sequence">10</field>
        </record>

        <!-- Tele Sales Agent Group -->
        <record id="group_tele_sales_agent" model="res.groups">
            <field name="name">Tele Sales Agent</field>
