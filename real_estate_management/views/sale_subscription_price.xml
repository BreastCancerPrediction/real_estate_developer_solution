<odoo>
<record id="sale_subscription_plan_view_form_inherit" model="ir.ui.view">
    <field name="name">sale.subscription.plan.view.form.inherit</field>
    <field name="model">sale.subscription.plan</field>
    <field name="inherit_id" ref="sale_subscription.sale_subscription_plan_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='pricing']/field[@name='product_subscription_pricing_ids']/list/field[@name='price']" position="replace">
            <field name="installment_percentage"/>
        </xpath>
    </field>
</record>
</odoo>
