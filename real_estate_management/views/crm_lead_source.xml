<odoo>
    <record id="view_crm_lead_source_form" model="ir.ui.view">
        <field name="name">view.crm.lead.source.form</field>
        <field name="model">crm.lead.source</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crm_lead_source_list" model="ir.ui.view">
        <field name="name">view.crm.lead.source.list</field>
        <field name="model">crm.lead.source</field>
        <field name="arch" type="xml">
            <list string="Lead Source">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_crm_lead_source" model="ir.actions.act_window">
        <field name="name">Crm Lead Source</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">crm.lead.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first housekeeping info!
            </p>
        </field>
    </record>

    <menuitem id="crm_menu_lead_source"
              name="Crm Lead Source"
              parent="crm.crm_menu_config"
              sequence="20"/>

    <menuitem name="Lead Source"
              id="crm_submenu_lead_source"
              action="real_estate_management.action_crm_lead_source"
              parent="real_estate_management.crm_menu_lead_source"/>




</odoo>