<?xml version="1.0" encoding="UTF-8" ?>
<templates>
     <t t-name="owl.KpiCard" owl="1">
        <div class="col-lg-3 m-0 p-0">
            <!-- Add the fixed size here -->
            <div class="shadow-sm border m-2 p-4 bg-white text-center cursor-pointer kpi-card"
                 style="width: 165px; height: 150px; display: flex; flex-direction: column; justify-content: center; align-items: center;"
                 t-on-click="()=>props.onClick()">
                <div class="fw-bold text-dark" style="font-size: 20px; color: #38017a !important;">
                    <span t-esc="props.value"/>
                </div>
                <div class="h3 text-muted"><span t-esc="props.name"/></div>
            </div>
        </div>
    </t>
</templates>
