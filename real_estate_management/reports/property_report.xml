<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Report action for brochure -->
    <record id="action_property_brochure" model="ir.actions.report">
        <field name="name">Property Brochure</field>
        <field name="model">property.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_management.property_brochure</field>
        <field name="report_file">real_estate_management.property_brochure</field>
        <field name="print_report_name">'Property Brochure - %s' %(object.name)</field>
        <field name="binding_model_id" ref="model_property_property"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template for brochure -->
   <template id="property_brochure">
    <t t-call="web.html_container">
        <t t-call="web.external_layout">
            <div class="page"
                 style="page-break-inside: avoid; font-family: 'Open Sans', sans-serif; color: #3A4750; padding: 30px; border: 1px solid #CFD8DC; border-radius: 15px; max-width: 900px; margin: auto; box-shadow: 0 8px 25px rgba(0,0,0,0.1); background-color: #FFFFFF;">
                <t t-foreach="docs" t-as="data">

                    <div style="text-align: center; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 3px solid #E0F2F7;">
                        <h1 style="font-size: 3.8em; font-weight: 700; color: #263238; text-transform: uppercase; letter-spacing: 3px; font-family: 'Open Sans', sans-serif; margin: 0;">
                            <t t-esc="data['name']"/>
                        </h1>
                        <p style="color: #607D8B; font-size: 1.5em; margin-top: 15px; font-style: italic;">Your Dream Property Awaits!</p>
                    </div>

                    <div style="text-align: center; margin-bottom: 50px;">
                        <div style="display: inline-block; border-radius: 25px; overflow: hidden; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3); border: 6px solid #B0E0E6;">
                            <img t-attf-src="data:image/png;base64,{{data['image']}}"
                                 style="max-height: 350px; max-width: 100%; width: auto; object-fit: cover; display: block;"/>
                        </div>
                    </div>

                    <div style="text-align:center; color: #546E7A; font-size: 1.3em; margin-bottom: 50px; line-height: 1.7; padding: 20px; background-color: #F5F8FA; border-radius: 12px; box-shadow: inset 0 2px 8px rgba(0,0,0,0.08);">
                        <span t-if="data['street']">
                            <t t-esc="data['street']"/>
                            <t t-if="data['street2']">,</t>
                        </span>
                        <span t-if="data['street2']">
                            <t t-esc="data['street2']"/>
                            <br t-if="data['city'] or data['zip']"/>
                        </span>
                        <span t-if="data['city']">
                            <t t-esc="data['city']"/>
                            <t t-if="data['zip']">,</t>
                        </span>
                        <span t-if="data['zip']">
                            <t t-esc="data['zip']"/>
                            <br t-if="data['state_id'] or data['country_id']"/>
                        </span>
                        <span t-if="data['state_id']">
                            <t t-esc="data['state_id'].name"/>
                            <t t-if="data['country_id']">,</t>
                        </span>
                        <span t-if="data['country_id']">
                            <t t-esc="data['country_id'].name"/>
                        </span>
                    </div>

                    <div style="background-color: #EBF7F9; border-radius: 18px; padding: 45px; margin-bottom: 55px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);">
                        <h2 style="color: #00838F; margin-bottom: 35px; border-bottom: 3px solid #B2EBF2; padding-bottom: 18px; font-size: 2.2em; text-align: center; font-weight: 600;">
                            Property Details
                        </h2>
                        <table class="table table-borderless" style="width:100%; border-collapse: collapse;">
                            <tr style="border-bottom: 1px solid #E0F2F7;">
                                <td style="padding: 20px 0; font-weight: bold; width: 35%; color: #3A4750; font-size: 1.15em;">
                                    Project
                                </td>
                                <td style="padding: 20px 0; width: 15%; color: #0097A7;">
                                    <t t-if="data['project_id'] and data['project_id'].name">
                                        <t t-esc="data['project_id'].name"/>
                                    </t>
                                    <t t-if="not data['project_id'] or not data['project_id'].name">
                                        N/A
                                    </t>
                                </td>
                                <td style="padding: 20px 0; font-weight: bold; width: 35%; color: #3A4750; font-size: 1.15em;">
                                    Responsible Person
                                </td>
                                <td style="padding: 20px 0; width: 15%; color: #0097A7;">
                                    <t t-if="data['responsible_id'] and data['responsible_id'].name">
                                        <t t-esc="data['responsible_id'].name"/>
                                    </t>
                                    <t t-if="not data['responsible_id'] or not data['responsible_id'].name">
                                        N/A
                                    </t>
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #E0F2F7;">
                                <td style="padding: 20px 0; font-weight: bold; width: 35%; color: #3A4750; font-size: 1.15em;">
                                    Latitude
                                </td>
                                <td style="padding: 20px 0; width: 15%; color: #0097A7;">
                                    <t t-esc="data['latitude']"/>
                                </td>
                                <td style="padding: 20px 0; font-weight: bold; width: 35%; color: #3A4750; font-size: 1.15em;">
                                    Longitude
                                </td>
                                <td style="padding: 20px 0; width: 15%; color: #0097A7;">
                                    <t t-esc="data['longitude']"/>
                                </td>
                            </tr>
                            <tr style="border-bottom: 1px solid #E0F2F7;">
                                <td style="padding: 20px 0; font-weight: bold; color: #3A4750; font-size: 1.15em;">
                                    Constructed Year
                                </td>
                                <td style="padding: 20px 0; color: #0097A7;">
                                    <t t-esc="data['construct_year']"/>
                                </td>
                                <td style="padding: 20px 0; font-weight: bold; color: #3A4750; font-size: 1.15em;">
                                    License Number
                                </td>
                                <td style="padding: 20px 0; color: #0097A7;">
                                    <t t-esc="data['license_no']"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 20px 0; font-weight: bold; color: #3A4750; font-size: 1.15em;">
                                    Property Type
                                </td>
                                <td style="padding: 20px 0; color: #0097A7;">
                                    <t t-esc="data['property_type']"/>
                                </td>
                                <td style="padding: 20px 0; font-weight: bold; color: #3A4750; font-size: 1.15em;">
                                    Total Measurement
                                </td>
                                <td style="padding: 20px 0; color: #0097A7;">
                                    <t t-esc="data['total_sq_feet']"/>
                                    ft²
                                </td>
                            </tr>
                        </table>
                    </div>

                    <t t-if="data['facility_ids']">
                        <div style="background-color: #EBF8E7; border-radius: 18px; padding: 45px; margin-bottom: 55px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);">
                            <h2 style="color: #4CAF50; margin-bottom: 35px; border-bottom: 3px solid #C8E6C9; padding-bottom: 18px; font-size: 2.2em; text-align: center; font-weight: 600;">
                                Outstanding Facilities
                            </h2>
                            <ul style="list-style: none; padding-left: 0; display: flex; flex-wrap: wrap; justify-content: center;">
                                <t t-foreach="data['facility_ids']" t-as="rec">
                                    <li style="background-color: #A5D6A7; color: #388E3C; padding: 15px 30px; border-radius: 35px; margin: 12px; font-weight: 600; display: inline-flex; align-items: center; transition: background-color 0.3s ease, transform 0.2s ease; box-shadow: 0 3px 8px rgba(0,0,0,0.15);">
                                        <span style="margin-right: 12px; font-size: 1.4em;">&#10003;</span>
                                        <t t-esc="rec['facility']"/>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </t>

                    <t t-if="data['nearby_connectivity_ids']">
                        <div style="background-color: #FFFCEE; border-radius: 18px; padding: 45px; margin-bottom: 55px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);">
                            <h2 style="color: #FFB300; margin-bottom: 35px; border-bottom: 3px solid #FFECB3; padding-bottom: 18px; font-size: 2.2em; text-align: center; font-weight: 600;">
                                Convenient Connectivities
                            </h2>
                            <ul class="list-group" style="padding-left: 0;">
                                <t t-foreach="data['nearby_connectivity_ids']" t-as="rec">
                                    <li class="list-group-item"
                                        style="background-color: #FFF9C4; border: 1px solid #FFECB3; margin-bottom: 15px; padding: 20px 30px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 1.2em; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                        <span style="font-weight: 600; color: #FF8F00;">
                                            <t t-esc="rec['name']"/>
                                        </span>
                                        <span style="color: #FF8F00; font-style: italic; font-weight: 500;">
                                            <t t-esc="rec['kilometer']"/>
                                            Kilometers
                                        </span>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </t>

                    <t t-if="data['property_image_ids']">
                        <div style="background-color: #EBF7F9; border-radius: 18px; padding: 45px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);">
                            <h2 style="color: #00838F; margin-bottom: 35px; border-bottom: 3px solid #B2EBF2; padding-bottom: 18px; font-size: 2.2em; text-align: center; font-weight: 600;">
                                Captivating Gallery
                            </h2>
                            <table style="width:100%; border-collapse: separate; border-spacing: 0 35px;">
                                <t t-set="image_list" t-value="data['property_image_ids']"/>
                                <t t-set="rows" t-value="range(0, len(image_list), 2)"/>
                                <t t-foreach="rows" t-as="i">
                                    <tr>
                                        <td style="width:50%; vertical-align:top; padding-right:30px;"
                                            t-if="image_list[i]">
                                            <div style="background-color: white; border-radius: 15px; padding: 30px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1); display: flex; align-items: center; border: 1px solid #CFD8DC;">
                                                <div style="flex: 0 0 auto; margin-right: 25px; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
                                                    <img t-attf-src="data:image/png;base64,{{image_list[i]['image']}}"
                                                         style="max-height: 120px; max-width: 180px; object-fit: cover; display: block;"/>
                                                </div>
                                                <div style="flex: 1; text-align: left;">
                                                    <h4 style="color: #34495E; margin: 0 0 10px 0; font-size: 1.4em; text-decoration: underline; text-decoration-color: #80DEEA; font-weight: 600;">
                                                        <t t-esc="image_list[i]['name']"/>
                                                    </h4>
                                                    <p style="color: #607D8B; font-size: 1.05em; line-height: 1.6; margin: 0;">
                                                        <t t-esc="image_list[i]['description']"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="width:50%; vertical-align:top; padding-left:30px;"
                                            t-if="i+1 &lt; len(image_list)">
                                            <div style="background-color: white; border-radius: 15px; padding: 30px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1); display: flex; align-items: center; border: 1px solid #CFD8DC;">
                                                <div style="flex: 0 0 auto; margin-right: 25px; border-radius: 12px; overflow: hidden; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
                                                    <img t-attf-src="data:image/png;base64,{{image_list[i+1]['image']}}"
                                                         style="max-height: 120px; max-width: 180px; object-fit: cover; display: block;"/>
                                                </div>
                                                <div style="flex: 1; text-align: left;">
                                                    <h4 style="color: #34495E; margin: 0 0 10px 0; font-size: 1.4em; text-decoration: underline; text-decoration-color: #80DEEA;">
                                                        <t t-esc="image_list[i+1]['name']"/>
                                                    </h4>
                                                    <p style="color: #607D8B; font-size: 1.05em; line-height: 1.6; margin: 0;">
                                                        <t t-esc="image_list[i+1]['description']"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="width:50%;"
                                            t-if="i+1 == len(image_list) and len(image_list) % 2 != 0">
                                            </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </t>
                    <div style="page-break-after: always;"></div>
                </t>
            </div>
        </t>
    </t>
</template>

